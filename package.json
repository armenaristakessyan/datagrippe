{
  "name": "datagrippe",
  "productName": "DataGrippe",
  "version": "0.2.0",
  "description": "A modern, simple database IDE for PostgreSQL and SQL Server",
  "main": "./out/main/index.js",
  "author": "Armen Aristakessyan",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "npm run build && playwright test",
    "db:up": "docker compose -f docker-compose.test.yml up -d",
    "db:down": "docker compose -f docker-compose.test.yml down -v",
    "dist": "npm run build && electron-builder --mac --publish never",
    "dist:dir": "npm run build && electron-builder --mac --dir --publish never",
    "dist:release": "npm run build && electron-builder --mac dmg --arm64 --x64 --publish never",
    "dist:local": "npm run build && electron-builder --mac dmg --arm64 --publish never -c.mac.icon=$(test -f build/local/icon.icns && echo build/local/icon.icns || echo build/icon.png)"
  },
  "dependencies": {
    "mssql": "^12.7.4",
    "pg": "^8.23.1",
    "pg-cursor": "^2.22.1",
    "ssh2": "^1.17.0"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@monaco-editor/react": "^4.7.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-virtual": "^3.14.13",
    "@types/mssql": "^12.3.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/pg-cursor": "^2.7.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ssh2": "^1.15.6",
    "@vitejs/plugin-react": "^5.2.0",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "jsdom": "^26.0.0",
    "lucide-react": "^1.52.0",
    "monaco-editor": "^0.57.0",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-resizable-panels": "^4.14.2",
    "sonner": "^2.0.8",
    "sql-formatter": "^15.9.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "vite": "^7.3.6",
    "vitest": "^4.1.11",
    "zustand": "^5.0.15"
  },
  "build": {
    "appId": "dev.datagrippe.app",
    "productName": "DataGrippe",
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "**/*.node"
    ],
    "icon": "build/icon.png",
    "extraResources": [
      {
        "from": "build/icon.png",
        "to": "icon.png"
      }
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        "dmg"
      ],
      "icon": "build/icon.png",
      "identity": "-"
    },
    "dmg": {
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    }
  }
}
